# The image `make release` runs `make push_to_gh` (and `make unrelease` runs `make delete_gh_release`) in.
# It needs make, perl (perl-base is part of the base image) and gh - nothing else.
#
# PINNED: the base by tag AND digest, gh by version AND sha256, so two releases of the same commit run
# the same tools. Moving a pin is a deliberate edit here, never something a rebuild does on its own.
#
# NO CREDENTIAL IN THE IMAGE: GITHUB_GH_TOKEN reaches the container at run time only
# (`docker run -e GITHUB_GH_TOKEN`); an `ENV GITHUB_GH_TOKEN=<placeholder>` line would be baked into
# every layer and is what BuildKit's SecretsUsedInArgOrEnv check flags. `docker build --check` is clean.
FROM debian:13.6-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

ARG GH_VERSION=2.101.0
ARG GH_DEB_SHA256=f876a3b87bf67c94f773d17becca4dc7340b056dab901473a9260ee2a73e237b

ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

ADD --checksum=sha256:${GH_DEB_SHA256} \
    https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.deb /tmp/gh.deb

RUN apt-get update -qq \
  && apt-get install -qq -y --no-install-recommends make ca-certificates /tmp/gh.deb \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /home/ondewo/

COPY Makefile .

COPY LICENSE .

COPY README.md .

COPY RELEASE.md .

COPY ondewo ondewo

# run the container forever
CMD ["tail", "-f", "/dev/null"]
